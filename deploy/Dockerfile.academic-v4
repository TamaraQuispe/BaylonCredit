# Standalone demo API runtime; no experiment/training runners are copied.
FROM python:3.12.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN groupadd --system app && useradd --system --gid app --create-home app
COPY backend/pyproject.toml ./
COPY backend/app ./app
COPY backend/scripts/export_real_credit_outcomes.py backend/scripts/train_real_credit_model.py ./scripts/
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
COPY deploy/requirements-academic-v4.txt /tmp/requirements-academic-v4.txt
RUN pip install -c /tmp/requirements-academic-v4.txt .
USER app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
