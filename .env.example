POSTGRES_DB=bayloncredit
POSTGRES_USER=baylon
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
ADMIN_EMAIL=admin@baylon.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Administrador Baylon
VITE_API_URL=http://localhost:8000/api/v1

# --- Explicaciones de evaluacion crediticia con OpenRouter (opcional) ---
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Credifycredit
OPENROUTER_TIMEOUT_SECONDS=10

# --- WhatsApp Business API (opcional, desactivado por defecto) ---
# Activa la integracion de WhatsApp (envios reales via Graph API).
WHATSAPP_ENABLED=false
# Token de acceso permanente de la app de Meta (ETP/System User, ejemplo: EAAJ...).
WHATSAPP_TOKEN=
# ID numerico del numero de telefono verificado en el panel de la app.
WHATSAPP_PHONE_NUMBER_ID=
# Token libre que elegiras al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (para verificar la firma del webhook).
WHATSAPP_APP_SECRET=
# Notificar el resultado de cada evaluacion de credito al cliente.
WHATSAPP_NOTIFY_EVALUATIONS=false
# Recordar por WhatsApp los creditos vencidos o proximos a vencer.
WHATSAPP_NOTIFY_REMINDERS=false
# Cada cuantas horas se ejecuta el ciclo de recordatorios (default 24).
WHATSAPP_REMINDER_INTERVAL_HOURS=24
# Con cuantos dias de anticipacion empezar a recordar (default 3).
WHATSAPP_REMINDER_DAYS_BEFORE=3
