# Plantilla de configuración para desplegar BaylonCredit en una VPS de producción.
# Copia a .env.prod, rellena los valores y despliega:
#   docker compose --env-file .env.prod -f docker-compose.yml \
#     -f docker-compose.prod.yml up --build -d

# Cadena de conexión de la API a PostgreSQL. El host es el nombre del servicio
# "database" del compose (red interna); la petición no sale a internet.
# Ejemplo con credenciales fuertes:
DATABASE_URL=postgresql+asyncpg://baylon:SUSTITUYE_POR_CLAVE_DB@database:5432/bayloncredit

# Credenciales del contenedor PostgreSQL. Deben coincidir con el usuario/password
# de DATABASE_URL (mismo usuario y clave, sin el prefijo asyncpg).
POSTGRES_DB=bayloncredit
POSTGRES_USER=baylon
POSTGRES_PASSWORD=SUSTITUYE_POR_CLAVE_DB

# Secreto JWT: al menos 32 caracteres aleatorios. Genera uno con:
#   openssl rand -hex 32
JWT_SECRET_KEY=SUSTITUYE_POR_SECRETO_JWT

# Entorno y dominios permitidos para CORS. Si aún no tienes dominio, usa la IP:
#   CORS_ORIGINS=https://IP_PUBLICA
# Cuando tengas dominio HTTPS:
#   CORS_ORIGINS=https://app.midominio.com
CORS_ORIGINS=https://IP_PUBLICA
ENVIRONMENT=production

# Duración de tokens (opcional, por defecto en backend).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Bloqueo anti fuerza bruta (opcional).
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Primer administrador que crea la tarea bootstrap (solo la primera vez).
ADMIN_EMAIL=admin@bayloncredit.com
ADMIN_PASSWORD=SUSTITUYE_POR_CLAVE_ADMIN_FUERTE
ADMIN_FULL_NAME=Administrador Baylon