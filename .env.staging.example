# Plantilla de configuración para el entorno de staging.
# Copia a .env.staging, completa los valores y ejecuta:
#   docker compose --env-file .env.staging -f docker-compose.yml -f docker-compose.staging.yml up --build -d

# Cadena de conexión a PostgreSQL administrado (managed), con backup y cifrado TLS.
DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/bayloncredit

# Secreto JWT: al menos 32 caracteres aleatorios. Usa el gestor de secretos del proveedor.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Orígenes permitidos para CORS (dominios del frontend y la API).
CORS_ORIGINS=https://app.staging.bayloncredit.com

# Duración de tokens (opcional, por defecto en backend).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Bloqueo anti fuerza bruta en login (opcional, por defecto en backend).
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Primer administrador que crea la tarea bootstrap.
ADMIN_EMAIL=admin@bayloncredit.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Administrador Baylon